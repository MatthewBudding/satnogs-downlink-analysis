
# Copy this file to .env and fill in real values.
# Google Cloud
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-west2
GCS_BUCKET=your-bucket-name
BQ_DATASET=satnogs

# Path to credentials file
GOOGLE_APPLICATION_CREDENTIALS=

# SatNOGS API
SATNOGS_API_BASE_URL=https://network.satnogs.org/api
SATNOGS_REQUEST_DELAY_SECONDS=1.0

# Local storage
LOCAL_DATA_DIR=

# Airflow (Linux/WSL: set to the output of `id -u`)
AIRFLOW_UID=